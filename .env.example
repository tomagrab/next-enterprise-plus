# App Configuration
NEXT_PUBLIC_COMPANY_NAME='Company Name'
NEXT_PUBLIC_COMPANY_START_YEAR='2024'
NEXT_PUBLIC_APP_NAME='Next Enterprise Plus'

# NextAuth.js Configuration (v4)
# Generate a secret with: npx auth secret
NEXTAUTH_SECRET=your-auth-secret-here

# Application URL (set this in production)
NEXTAUTH_URL=http://localhost:3000

# GitHub OAuth (uncomment and configure when needed)
# Get these from: https://github.com/settings/developers
# AUTH_GITHUB_ID=your-github-client-id
# AUTH_GITHUB_SECRET=your-github-client-secret

# Google OAuth (uncomment and configure when needed)
# Get these from: https://console.developers.google.com/
# AUTH_GOOGLE_ID=your-google-client-id
# AUTH_GOOGLE_SECRET=your-google-client-secret

# Microsoft Entra ID OAuth (formerly Azure AD) (uncomment and configure when needed)
# Get these from: https://entra.microsoft.com/ (Admin Center)
# Callback URL: http://localhost:3000/api/auth/callback/microsoft-entra-id
# AUTH_MICROSOFT_ENTRA_ID_ID=your-client-id
# AUTH_MICROSOFT_ENTRA_ID_SECRET=your-client-secret
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/your-tenant-id/v2.0

# Database (if using database sessions/adapters)
# DATABASE_URL=your-database-connection-string

# Feature Flags Configuration
# Provider type: 'local' for static flags, or third-party provider name
NEXT_PUBLIC_FF_PROVIDER=local

# Refresh interval in milliseconds (default: 900000 = 15 minutes)
FEATURE_FLAGS_REFRESH_INTERVAL_MS=900000

# Example local feature flags (prefix with NEXT_PUBLIC_FF_)
# NEXT_PUBLIC_FF_NEW_DASHBOARD=true
# NEXT_PUBLIC_FF_BETA_FEATURES=false
# NEXT_PUBLIC_FF_EXPERIMENTAL_UI=true
